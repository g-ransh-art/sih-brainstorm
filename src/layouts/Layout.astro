---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Smart India Hackathon',
  description = 'A brainstorm-ready master document for sih 2026.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="#" class="logo">SIH<span>26</span></a>
        <nav class="nav">
          <a href="#playbook">Playbook</a>
          <a href="#problems">Problems</a>
          <a href="#concepts">Concepts</a>
          <a href="#brainstorm">Brainstorm</a>
        </nav>
        <a href="#pick" class="btn btn-primary btn-small">Pick an idea</a>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© 2026 · SIH Strategy OS</span>
        <span class="mono">Built with Astro · Deploy on <a href="https://vercel.com">▲ Vercel</a></span>
      </div>
    </footer>
  </body>
</html>