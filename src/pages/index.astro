---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="hero">
    <div class="container">
      <p class="badge mono">Team Gravity</p>
      <h1>Think like a judge.<br />Think like a problem owner.</h1>
      <p class="hero-sub">Technology is the last decision, not the first.</p>
      <div class="hero-actions">
        <a href="/playbook" class="btn btn-primary"> Read the playbook</a>
        <a href="/brainstorm" class="btn btn-hero-ghost">Open brainstorm studio</a>
      </div>
      <div class="hero-stats">
        <span>50 broken workflows</span>
        <span>30 product concepts</span>
        <span>1 recommended winner</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3 home-cards">
        <a href="/playbook" class="card home-card">
          <h3>Playbook</h3>
          <p>Winning pattern analysis, reject list, white-space map, scoring rubric.</p>
        </a>
        <a href="/problems" class="card home-card">
          <h3>Problems</h3>
          <p>50 government workflows that break at scale. Shortlist your favourites.</p>
        </a>
        <a href="/concepts" class="card home-card">
          <h3>Concepts</h3>
          <p>30 full stack concepts with weighted SIH scores and demo potential.</p>
        </a>
      </div>
    </div>
  </section>
</Layout>