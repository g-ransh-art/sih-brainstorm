---
import Layout from '../layouts/Layout.astro';
import ProblemExplorer from '../components/ProblemExplorer.astro';
import ConceptExplorer from '../components/ConceptExplorer.astro';
import BrainstormPanel from '../components/BrainstormPanel.astro';
import { concepts } from '../data/concepts.js';

const rejectList = [
  ['Crop disease detection app', 'Every team with a CNN and a camera will build this.'],
  ['Women’s safety SOS app', 'Built 10,000 times. No differentiation possible.'],
  ['Smart attendance using face recognition', 'Commercially solved. Zero novelty.'],
  ['Generic AI chatbot for government', 'Vague, not deployable, judges have seen 300.'],
  ['Smart waste bin with IoT', 'Hardware version of a dashboard problem.'],
  ['Traffic congestion prediction', 'Every ML student defaults here.'],
  ['Generic telemedicine platform', 'Solved by Practo, eSanjeevani, Apollo.'],
  ['Blockchain certificate verification', 'Over-cited, rarely justified, hard to demo.'],
  ['Generic tourism recommendation', 'Solved by Google Maps + Tripadvisor.'],
  ['Mental health chatbot', 'Generic, hard to validate, liability concerns.']
];

const sectorScans = [
  ['Healthcare', ['Patient referral from PHC to district hospital is manual and broken.', 'Medicine stock-outs at rural PHCs discovered weeks late.', 'ASHA worker field data is stale before it reaches analysts.']],
  ['Railways', ['Unreserved coach overcrowding has no warning system.', 'Level crossing gates depend on fragile phone calls.', 'Parcels on passenger trains have no real-time tracking.']],
  ['Agriculture', ['Crop insurance claims bottleneck at patwari visits.', 'Mandi arrival volumes are invisible.', 'Seed certification is forgeable with paper certificates.']],
  ['Urban Infra', ['Pothole complaints enter portals but don’t get routed or verified.', 'Building deviations from sanctioned plans are undetected.', 'Property tax self-assessment leaks massive revenue.']],
  ['Education', ['Teacher transfers are political, not data-driven.', 'Mid-day meal attendance is ghost-ridden.', 'Scholarship disbursal has no student receipt confirmation.']],
  ['Legal/Justice', ['Undertrials miss court hearings due to uncoordinated transport.', 'FIR complainants have no status visibility.', 'Legal aid assignment is manual and untracked.']],
  ['Disaster Management', ['Last-mile warning dissemination is unverified.', 'Relief camp supply is mismatched.', 'Post-flood damage assessment is too slow.']],
  ['Logistics', ['Overloaded trucks pass via corrupt weighbridges.', 'Cold chain integrity is logged on paper.', 'Minor port container dwell times are invisible.']],
  ['Cybersecurity', ['SIM swap fraud is siloed between telecom and banks.', 'Impersonation take-downs are slow and uncoordinated.']],
  ['Governance', ['RTI deadlines are missed with no escalation.', 'Government vendor payments take 90–180 days.', 'Inter-department file movement is opaque.']]
];
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="badge mono">SIH 2026 · Strategic Master Document</p>
      <h1>Think like a judge.<br />Think like a problem owner.</h1>
      <p class="hero-sub">Technology is the last decision, not the first.</p>
      <div class="hero-actions">
        <a href="#problems" class="btn btn-primary">Explore 50 problems</a>
        <a href="#brainstorm" class="btn btn-hero-ghost">Open brainstorm studio</a>
      </div>
      <div class="hero-stats">
        <span>4 winning case studies</span>
        <span>15 sector scans</span>
        <span>50 whitespace problems</span>
        <span>30 product concepts</span>
      </div>
    </div>
  </section>

  <div class="layout container">
    <!-- LEFT SIDEBAR -->
    <aside class="sidebar-left">
      <nav class="card toc">
        <h4>Navigate</h4>
        <a href="#playbook">Phase 1 · Pattern Analysis</a>
        <a href="#sectors">Phase 4 · White-Space Map</a>
        <a href="#problems">Phase 5 · 50 Problems</a>
        <a href="#concepts">Phase 7 · 30 Concepts</a>
        <a href="#brainstorm">Brainstorm Studio</a>
        <a href="#pick">Final Idea Picker</a>
      </nav>

      <div class="card shortlist">
        <h4>Your shortlist</h4>
        <div id="shortlist-list"></div>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main>
      <!-- PHASE 1 -->
      <section id="playbook" class="section">
        <div class="container">
          <p class="section-kicker mono">Phase 1</p>
          <h2>Winning Project Pattern Analysis</h2>
          <p class="lead">Before generating a single idea, reverse-engineer what actually made SIH winners win.</p>

          <div class="formula-card">
            <h3>Winning Formula</h3>
            <pre class="mono">Operationally specific problem
+ Clear broken “before”
+ Technology serves workflow
+ Complete chain: detect → classify → route → act → verify → close
+ One-sentence explainability
+ Government has a reason to care
+ Judge can see result in 30 seconds</pre>
            <p>
              <strong>#1 common failure:</strong> losing projects stop at “detect” or “display.” Winners continue to
              “act → verify → close → learn.”
            </p>
          </div>

          <div class="grid grid-2 winners-grid">
            <details class="card winner-card">
              <summary><span class="mono">#1</span> Language Translation for Station Announcements</summary>
              <div class="winner-body">
                <p><strong>Ministry:</strong> Railways</p>
                <p><strong>Problem:</strong> Non-Hindi/English passengers miss live station announcements.</p>
                <p><strong>Solution:</strong> Translate live announcements into regional languages and automatically call passengers.</p>
                <p><strong>Core insight:</strong> Last-mile accessibility for non-literate passengers in existing announcement infrastructure.</p>
                <p><strong>Why it won:</strong> High demo value, clear operational win, 23 million daily passengers affected.</p>
              </div>
            </details>

            <details class="card winner-card">
              <summary><span class="mono">#2</span> Unified Course Design Platform</summary>
              <div class="winner-body">
                <p><strong>Ministry:</strong> AICTE</p>
                <p><strong>Problem:</strong> Course structures are fragmented across AICTE-approved institutions.</p>
                <p><strong>Solution:</strong> One platform to design, organize, and share course structures across colleges.</p>
                <p><strong>Core insight:</strong> Workflow unification, not complex AI, was the innovation.</p>
                <p><strong>Why it won:</strong> A simple well-structured database won over complex ML because the workflow was broken.</p>
              </div>
            </details>

            <details class="card winner-card">
              <summary><span class="mono">#3</span> JalSamadhan</summary>
              <div class="winner-body">
                <p><strong>Ministry:</strong> Jal Shakti</p>
                <p><strong>Problem:</strong> Water complaints sit unrouted because manual classification and routing create delay.</p>
                <p><strong>Solution:</strong> Citizens report water problems → auto-classified → routed → tracked to closure.</p>
                <p><strong>Core insight:</strong> The broken link wasn’t reporting; it was everything after the report.</p>
                <p><strong>Why it won:</strong> Complete loop: report → classify → route → verify → close → learn.</p>
              </div>
            </details>

            <details class="card winner-card">
              <summary><span class="mono">#4</span> Face Recognition for Secure Areas</summary>
              <div class="winner-body">
                <p><strong>Ministry:</strong> DRDO</p>
                <p><strong>Problem:</strong> Manual guard check-in and visitor logbooks are security risks.</p>
                <p><strong>Solution:</strong> Automatically identify and track individuals through secured premises using camera feeds.</p>
                <p><strong>Core insight:</strong> Integration with existing infrastructure + movement tracking + anomaly alerting.</p>
                <p><strong>Why it won:</strong> The full operational chain, not just detection.</p>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- PHASE 2 -->
      <section class="section section-muted">
        <div class="container">
          <p class="section-kicker mono">Phase 2</p>
          <h2>SIH 2026 Context</h2>
          <p>
            Student teams work on problem statements given by Ministries, Departments, and Industries or submit their
            ideas under 17 themes covering sectors of national importance including Healthcare, Supply Chain &
            Logistics, Smart Technologies, Heritage and Culture, Sustainability, Education, and Skill Development.
          </p>
          <h3>What separates winners from the rest</h3>
          <ul class="stat-list">
            <li><strong>Problem understanding — 30%</strong><br />Do you actually understand the problem? Have you talked to real users?</li>
            <li><strong>Technical implementation — 25%</strong><br />Does it work? Is the code clean? Is the architecture sound?</li>
            <li><strong>Innovation — 20%</strong><br />What’s new? Why hasn’t this been done before?</li>
            <li><strong>Demo impact + government alignment — 25%</strong><br />Can a judge see the result in 30 seconds?</li>
          </ul>
          <p>Themes include health tech, agriculture, clean energy, cybersecurity, AI, tourism, education, and smart mobility.</p>
        </div>
      </section>

      <!-- PHASE 3 -->
      <section class="section">
        <div class="container">
          <p class="section-kicker mono">Phase 3</p>
          <h2>The 500-Teams Test — Reject List</h2>
          <p class="lead">Before generating ideas, eliminate entire categories that will be saturated.</p>

          <div class="grid grid-2 reject-grid">
            {
              rejectList.map(([name, reason]) => (
                <div class="card reject-card">
                  <h3>{name}</h3>
                  <p>{reason}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PHASE 4 -->
      <section id="sectors" class="section section-muted">
        <div class="container">
          <p class="section-kicker mono">Phase 4</p>
          <h2>White-Space Mapping — Where India is Bleeding</h2>
          <p class="lead">Instead of asking “what cool app can we build?”, ask where time, money, safety, or resources are lost through broken workflows.</p>

          <div class="grid grid-2 sectors-grid">
            {
              sectorScans.map(([sector, items]) => (
                <div class="card sector-card">
                  <h3>{sector}</h3>
                  <ul>
                    {items.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PHASES 5 + 6 -->
      <ProblemExplorer />

      <!-- PHASE 7 -->
      <ConceptExplorer />
    </main>

    <!-- RIGHT SIDEBAR -->
    <aside class="sidebar-right">
      <BrainstormPanel />

      <div class="card picker" id="pick">
        <p class="section-kicker mono">Final Decision</p>
        <h3>Pick an idea to work on</h3>
        <label class="check">
          <input type="checkbox" id="use-shortlist" checked />
          Use shortlist only
        </label>
        <button id="pick-idea" class="btn btn-primary">🎲 Generate an idea</button>
        <div id="idea-result"></div>
        <button id="reset-shortlist" class="btn btn-ghost btn-small">Reset shortlist</button>
      </div>
    </aside>
  </div>

  <script is:inline define:vars={{ concepts }}>
    // ---------- Utilities ----------
    function esc(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[c]));
    }

    // ---------- Self Notes ----------
    const noteSelect = document.getElementById('note-concept');
    const noteText = document.getElementById('note-text');
    const saveNote = document.getElementById('save-note');
    const noteList = document.getElementById('note-list');
    let selfNotes = JSON.parse(localStorage.getItem('sih-self-notes') || '{}');

    function renderSelfNotes() {
      if (!noteList) return;
      noteList.innerHTML = Object.entries(selfNotes).map(([id, text]) =>
        `<div class="note-item">
          <button class="note-del" data-del="${esc(id)}">×</button>
          <strong>${esc(id)}</strong>
          <p>${esc(text)}</p>
        </div>`
      ).join('');
    }

    if (saveNote) {
      saveNote.addEventListener('click', () => {
        const id = noteSelect.value;
        selfNotes[id] = noteText.value.trim();
        localStorage.setItem('sih-self-notes', JSON.stringify(selfNotes));
        noteText.value = '';
        renderSelfNotes();
      });
    }

    if (noteList) {
      noteList.addEventListener('click', (e) => {
        const btn = e.target.closest('.note-del');
        if (!btn) return;
        delete selfNotes[btn.dataset.del];
        localStorage.setItem('sih-self-notes', JSON.stringify(selfNotes));
        renderSelfNotes();
      });
    }

    renderSelfNotes();

    // ---------- Public Notes ----------
    const pubName = document.getElementById('pub-name');
    const pubText = document.getElementById('pub-text');
    const postPublic = document.getElementById('post-public');
    const publicList = document.getElementById('public-list');
    let publicNotes = JSON.parse(localStorage.getItem('sih-public-notes') || '[]');

    function renderPublicNotes() {
      if (!publicList) return;
      publicList.innerHTML = publicNotes.slice().reverse().map((n) =>
        `<div class="note-item">
          <span class="pub-author">${esc(n.author)}</span>
          <span class="mono micro">${esc(n.time)}</span>
          <p>${esc(n.text)}</p>
        </div>`
      ).join('') || '<p class="micro">No public notes yet. Start the conversation.</p>';
    }

    if (postPublic) {
      postPublic.addEventListener('click', () => {
        const author = pubName.value.trim() || 'Anonymous';
        const text = pubText.value.trim();
        if (!text) return;
        publicNotes.push({
          author,
          text,
          time: new Date().toLocaleString()
        });
        localStorage.setItem('sih-public-notes', JSON.stringify(publicNotes));
        pubText.value = '';
        renderPublicNotes();
      });
    }

    renderPublicNotes();

    // ---------- Shortlist ----------
    let shortlist = JSON.parse(localStorage.getItem('sih-shortlist') || '[]');
    const shortlistEl = document.getElementById('shortlist-list');

    function renderShortlist() {
      if (!shortlistEl) return;
      shortlistEl.innerHTML = shortlist.map((id) => {
        const c = concepts.find((c) => c.id === Number(id));
        return c
          ? `<div class="shortlist-item">
              <a href="#concept-${c.id}">${c.id}. ${esc(c.name)}</a>
              <button class="link-del" data-remove="${c.id}">×</button>
            </div>`
          : '';
      }).join('') || '<p class="micro">Nothing yet. Click + Shortlist on any concept.</p>';
    }

    function syncShortlistButtons() {
      document.querySelectorAll('.shortlist-btn').forEach((btn) => {
        const id = Number(btn.dataset.id);
        if (shortlist.includes(id)) {
          btn.textContent = '✓ Shortlisted';
          btn.disabled = true;
        }
      });
    }

    document.addEventListener('click', (e) => {
      const addBtn = e.target.closest('.shortlist-btn');
      if (addBtn) {
        const id = Number(addBtn.dataset.id);
        if (!shortlist.includes(id)) shortlist.push(id);
        localStorage.setItem('sih-shortlist', JSON.stringify(shortlist));
        renderShortlist();
        syncShortlistButtons();
      }

      const delBtn = e.target.closest('.link-del');
      if (delBtn) {
        shortlist = shortlist.filter((id) => id !== Number(delBtn.dataset.remove));
        localStorage.setItem('sih-shortlist', JSON.stringify(shortlist));
        renderShortlist();
        syncShortlistButtons();
      }
    });

    renderShortlist();
    syncShortlistButtons();

    // ---------- Reset Shortlist ----------
    document.getElementById('reset-shortlist')?.addEventListener('click', () => {
      shortlist = [];
      localStorage.setItem('sih-shortlist', JSON.stringify(shortlist));
      renderShortlist();
      syncShortlistButtons();
    });

    // ---------- Idea Picker ----------
    const pickBtn = document.getElementById('pick-idea');
    const ideaResult = document.getElementById('idea-result');
    const useShortlist = document.getElementById('use-shortlist');

    function pickIdea() {
      let pool = concepts;
      if (useShortlist && useShortlist.checked && shortlist.length) {
        pool = concepts.filter((c) => shortlist.includes(c.id));
      }
      if (!pool.length) pool = concepts;

      const idea = pool[Math.floor(Math.random() * pool.length)];

      ideaResult.innerHTML = `
        <div class="idea-card">
          <span class="badge">${esc(idea.theme)}</span>
          <h3>${esc(idea.name)}</h3>
          <p>${esc(idea.tagline)}</p>
          <p class="mono micro">${esc(idea.tech)}</p>
          <p>${esc(idea.problem)}</p>
        </div>`;
    }

    pickBtn.addEventListener('click', pickIdea);
    pickIdea();
  </script>
</Layout>